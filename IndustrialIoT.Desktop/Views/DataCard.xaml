<UserControl x:Class="IndustrialIoT.Desktop.Views.DataCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IndustrialIoT.Desktop.Views"
             mc:Ignorable="d"
             Background="#F0F2F5"
             d:DesignHeight="180" d:DesignWidth="1300">
    <Border CornerRadius="10" Margin="10,0,10,10">
        <UniformGrid Columns="3">
            <!--温度-->
            <GroupBox Background="White" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="🌡温度" Margin="20,20,0,0" FontSize="15" Foreground="#7F8C8D"/>
                    <StackPanel Orientation="Horizontal" Height="50">
                        <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1}}"
                                   FontSize="30" FontWeight="Black"
                                   Margin="20,10,5,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="°C" FontSize="18"
                                   VerticalAlignment="Bottom" Foreground="#7F8C8D"/>
                    </StackPanel>
                    <ProgressBar Height="5" Margin="20,5,5,0"
                                 Value="{Binding TemperatureProgress}" Maximum="100"/>
                    <TextBlock Text="{Binding TemperatureStatus}"
                               Margin="20,20,0,20" FontSize="15"
                               Foreground="{Binding TemperatureColor}"/>
                </StackPanel>
            </GroupBox>

            <!--湿度-->
            <GroupBox Background="White" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="💧湿度" Margin="20,20,0,0" FontSize="15" Foreground="#7F8C8D"/>
                    <StackPanel Orientation="Horizontal" Height="50">
                        <TextBlock Text="{Binding Humidity, StringFormat={}{0:F1}}"
                                   FontSize="30" FontWeight="Black"
                                   Margin="20,10,5,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="%RH" FontSize="18"
                                   VerticalAlignment="Bottom" Foreground="#7F8C8D"/>
                    </StackPanel>
                    <ProgressBar Height="5" Margin="20,5,5,0"
                                 Value="{Binding HumidityProgress}" Maximum="100"/>
                    <TextBlock Text="{Binding HumidityStatus}"
                               Margin="20,20,0,20" FontSize="15"
                               Foreground="{Binding HumidityColor}"/>
                </StackPanel>
            </GroupBox>

            <!--压力-->
            <GroupBox Background="White">
                <StackPanel>
                    <TextBlock Text="⏲压力" Margin="20,20,0,0" FontSize="15" Foreground="#7F8C8D"/>
                    <StackPanel Orientation="Horizontal" Height="50">
                        <TextBlock Text="{Binding Pressure, StringFormat={}{0:F1}}"
                                   FontSize="30" FontWeight="Black"
                                   Margin="20,10,5,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="kPa" FontSize="18"
                                   VerticalAlignment="Bottom" Foreground="#7F8C8D"/>
                    </StackPanel>
                    <ProgressBar Height="5" Margin="20,5,5,0"
                                 Value="{Binding PressureProgress}" Maximum="100"/>
                    <TextBlock Text="{Binding PressureStatus}"
                               Margin="20,20,0,20" FontSize="15"
                               Foreground="{Binding PressureColor}"/>
                </StackPanel>
            </GroupBox>
        </UniformGrid>
    </Border>
</UserControl>
