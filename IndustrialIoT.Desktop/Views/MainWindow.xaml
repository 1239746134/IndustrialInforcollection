<Window x:Class="IndustrialIoT.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialIoT.Desktop.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        WindowStyle="None"
        Title="MainWindow" Height="1050" Width="1400">
    <Border CornerRadius="20">
        <DockPanel>
            <!--标题栏-->
            <Grid Height="44" DockPanel.Dock="Top" Background="#2C3E7B"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border>
                    <TextBlock FontSize="20" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"
                               Text="Modbus RTU 主站 · 工业设备数据采集"
                               Margin="80,0,0,0"
                               Foreground="White"
                               FontWeight="Black"
                               >
                    </TextBlock>
                </Border>
                <Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="当前时间:"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   Foreground="White"
                                   Margin="0,0,10,0"
                                   >
                        </TextBlock>

                        <TextBlock Text="{Binding CurrentTime}"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   Foreground="White"
                                   Margin="0,0,80,0"
                                   >
                        </TextBlock>

                        <Button Content="✕"
                                Width="36" Height="36"
                                Background="Transparent"
                                Foreground="White"
                                FontSize="16"
                                BorderThickness="0"
                                Click="BtnClose_Click"
                                Cursor="Hand"/>
                    </StackPanel>
                    
                </Border>
            </Grid>

            <!--状态栏-->
            <StatusBar   Height="30" DockPanel.Dock="Bottom" Background="White">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <!-- 默认红色 -->
                                        <Setter Property="Fill" Value="#E74C3C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <!-- 绿色 -->
                                                <Setter Property="Fill" Value="#27AE60"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="#2C3E50" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=" 已断开"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value=" 已连接"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Rectangle Width="2" Fill="#E0E4E8" Margin="10,3,10,3" HorizontalAlignment="Center"/>

                        <StatusBarItem>
                            <TextBlock Text="{Binding PortName, StringFormat='串口: {0}'}" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        </StatusBarItem>

                        <StatusBarItem>
                            <TextBlock Text="{Binding BaudRate, StringFormat='波特率: {0}'}" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        </StatusBarItem>

                        <StatusBarItem>
                            <TextBlock Text="{Binding DataBits, StringFormat='数据位: {0}'}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        </StatusBarItem>

                        <StatusBarItem>
                            <TextBlock Text="{Binding StopBits, StringFormat='停止位: {0}'}" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </StatusBarItem>

                        <Rectangle Width="2" Fill="#E0E4E8" Margin="10,3,10,3" HorizontalAlignment="Center"/>

                        <StatusBarItem>
                            <TextBlock Text="{Binding SlaveId, StringFormat='从站ID: {0}'}" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        </StatusBarItem>

                        <Rectangle Width="2" Fill="#E0E4E8" Margin="10,3,10,3" HorizontalAlignment="Center"/>

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LastReadTime, StringFormat='最后读取: {0}'}" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                <!--
                                <TextBlock Text="14:30:22" FontSize="12" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                -->
                            </StackPanel>
                        </StatusBarItem>

                        <Rectangle Width="2" Fill="#E0E4E8" Margin="10,3,10,3" HorizontalAlignment="Center"/>

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ReadCountTotal, StringFormat='读取次数: {0:N0}'}" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                <!--
                                <TextBlock Text="1,288" FontSize="12" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                -->
                            </StackPanel>
                        </StatusBarItem>
                    </StackPanel>

                </StatusBarItem>
            </StatusBar>


            <!--内容区-->
            <StackPanel>
                <Grid>
                    <!--串口配置面板-->
                    <GroupBox Height="200" Width="1200" HorizontalAlignment="Left" Margin="10,10,10,10" Background="White">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="1" Width="3" Height="15" Background="#2C3E7B" Margin="10,9,0,0"/>
                                <TextBlock Text="串口配置" Margin="5,15,15,6" FontSize="15"></TextBlock>
                            </StackPanel>
                            <UniformGrid Rows="2" Columns="4" Margin="20">
                                <!--串口号-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="串口号" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <ComboBox Width="150" Height="20" HorizontalAlignment="Center"
                                              ItemsSource="{Binding PortNames}"
                                              SelectedItem="{Binding PortConfig.PortName, UpdateSourceTrigger=PropertyChanged}"
                                              />
                                </StackPanel>
                                <!--波特率-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="波特率" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <ComboBox Width="150" Height="20" HorizontalAlignment="Center"
                                              ItemsSource="{Binding BaudRateOptions}"
                                              SelectedItem="{Binding PortConfig.BaudRate}"
                                              />
                                </StackPanel>
                                <!--数据位-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="数据位" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <ComboBox Width="150" Height="20" HorizontalAlignment="Center"
                                              ItemsSource="{Binding DataBitsOptions}"
                                              SelectedItem="{Binding PortConfig.DataBits}"
                                              />
                                </StackPanel>
                                <!--停止位-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="停止位" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <ComboBox Width="150" Height="20" HorizontalAlignment="Center"
                                              ItemsSource="{Binding StopBitsOptions}"
                                              SelectedItem="{Binding PortConfig.StopBits}"
                                              />
                                </StackPanel>
                                <!--校验位-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="校验位" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <ComboBox Width="150" Height="20" HorizontalAlignment="Center"
                                              ItemsSource="{Binding ParityOptions}"
                                              SelectedItem="{Binding PortConfig.Parity}"
                                              />
                                </StackPanel>
                                <!--从站ID-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="从站ID" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <TextBox Width="150" Height="20" HorizontalAlignment="Center" Background="#FAFBFC"
                                             Text="{Binding PortConfig.SlaveId, UpdateSourceTrigger=PropertyChanged}"
                                             />
                                </StackPanel>
                                <!--起始地址-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="起始地址" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <TextBox Width="150" Height="20" HorizontalAlignment="Center" Background="#FAFBFC"
                                             Text="{Binding PortConfig.StartAddress, UpdateSourceTrigger=PropertyChanged}"
                                             />
                                </StackPanel>
                                <!--读取数量-->
                                <StackPanel Orientation="Horizontal" Height="30" Margin="0,10,0,10">
                                    <TextBlock Text="读取数量" FontSize="15" Margin="0,0,15,0" VerticalAlignment="Center"></TextBlock>
                                    <TextBox Width="150" Height="20" HorizontalAlignment="Center" Background="#FAFBFC"
                                             Text="{Binding PortConfig.ReadCount, UpdateSourceTrigger=PropertyChanged}"
                                             />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <!-- 操作按钮面板-->
                    <GroupBox Height="200" Width="170" Margin="10,10,10,10" HorizontalAlignment="Right" Background="White">
                        <StackPanel>
                            <Button Margin="20,12,20,10" Command="{Binding ConnectCommand}" Height="30" Background="#27AE60" Foreground="White" FontSize="20">连接</Button>
                            <Button Margin="20,10,20,10" Command="{Binding DisconnectCommand}" Height="30" Background="White" BorderBrush="#E74C3C" BorderThickness="2" Foreground="#E74C3C" FontSize="20">断开</Button>
                            <Button Margin="20,10,20,10" Command="{Binding SingleReadCommand}" Height="30" Background="#2C3E7B" Foreground="White" FontSize="20">单次读取</Button>
                            <Button Margin="20,10,20,20" Command="{Binding AutoReadCommand}" Height="30" Background="#F39C12" Foreground="White" FontSize="20">自动读取</Button>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <!--数据卡片-->
                <Grid>
                    <local:DataCard DataContext="{Binding DataCard}"/>
                </Grid>
                <!--折线图-->
                <Grid>
                    <local:TrendChart DataContext="{Binding TrendChart}"/>
                </Grid>
                <!--通信日志面板-->
                <GroupBox Margin="10,0,10,0" Height="125" Background="White">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="1" Width="3" Height="15" Background="#2C3E7B" Margin="10,9,0,0"/>
                                <TextBlock Text="通信日志" FontSize="15" Margin="5,15,15,6" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                            </StackPanel>
                            <Button Width="90" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15" Background="White" BorderThickness="2" Click="BtnClearLog_Click">清空</Button>
                        </Grid>
                        <Grid>
                            <ListView ItemsSource="{Binding CommunicationLogs}" Height="75">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间" Width="80"
                                                        DisplayMemberBinding="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                        />
                                        <GridViewColumn Header="级别" Width="50"
                                                       DisplayMemberBinding="{Binding Level}"
                                                        />
                                        <GridViewColumn Header="消息" Width="600"
                                                        DisplayMemberBinding="{Binding Message}"
                                                        />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DockPanel>

    </Border>
</Window>
