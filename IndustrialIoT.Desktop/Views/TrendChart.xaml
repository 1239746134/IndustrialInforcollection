<UserControl x:Class="IndustrialIoT.Desktop.Views.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IndustrialIoT.Desktop.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             Background="#F0F2F5"
             d:DesignHeight="440" d:DesignWidth="1300">
    <StackPanel Margin="10,0,10,10">
        <!--温度折线-->
        <GroupBox Height="215" Background="White" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="📈 温度趋势" FontSize="15" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" Fill="#E74C3C" RadiusX="5" RadiusY="5"/>
                        <TextBlock Text="温度" Margin="4,0,0,0" FontSize="12" Foreground="#7F8C8D"/>
                        <Rectangle Width="20" Height="1" Stroke="#F39C12" StrokeDashArray="3,2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="上限 60°C" Margin="4,0,0,0" FontSize="12" Foreground="#7F8C8D"/>
                    </StackPanel>
                </Grid>

                <lvc:CartesianChart Series="{Binding TemperatureSeries}"
                                    XAxes="{Binding TempXAxes}"
                                    YAxes="{Binding TempYAxes}"
                                    Height="188"
                                    Margin="5,0,5,10"
                                    AnimationsSpeed="0"
                                    TooltipPosition="Top"/>
            </StackPanel>
        </GroupBox>

        <!--湿度折线-->
        <GroupBox Height="215" Background="White">
            <StackPanel>
                <Grid>
                    <TextBlock Text="📈 湿度趋势" FontSize="15" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" Fill="#3498DB" RadiusX="5" RadiusY="5"/>
                        <TextBlock Text="湿度" Margin="4,0,0,0" FontSize="12" Foreground="#7F8C8D"/>
                        <Rectangle Width="20" Height="1" Stroke="#F39C12" StrokeDashArray="3,2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="上限 80%RH" Margin="4,0,0,0" FontSize="12" Foreground="#7F8C8D"/>
                    </StackPanel>
                </Grid>

                <lvc:CartesianChart Series="{Binding HumiditySeries}"
                                    XAxes="{Binding HumXAxes}"
                                    YAxes="{Binding HumYAxes}"
                                    Height="188"
                                    Margin="5,0,5,10"
                                    AnimationsSpeed="0"
                                    TooltipPosition="Top"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
